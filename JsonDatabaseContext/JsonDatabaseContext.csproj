<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Assembly Info -->
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<!-- NuGet Package Info -->
		<PackageId>JsonDatabaseContext</PackageId>
		<Title>JsonDatabaseContext</Title>
		<Version>1.0.0</Version>
		<Authors>drualcman</Authors>
		<Description>A lightweight C# library that provides a JSON-based database context with asynchronous CRUD operations. Perfect for applications needing simple persistence without heavy database dependencies. Features concurrent-safe operations, automatic ID generation, and an API similar to Entity Framework.</Description>
		<PackageProjectUrl>https://github.com/drualcman/JsonDatabaseContext</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/drualcman/JsonDatabaseContext</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>json;database;persistence;crud;async;entity-framework;lightweight;file-storage</PackageTags>
		<PackageReleaseNotes>Initial release of JsonDatabaseContext with core functionality for JSON-based data persistence.</PackageReleaseNotes>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<!-- Documentation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>

		<!-- Additional Metadata -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<!-- Package Settings -->
		<DeterministicSourcePaths>true</DeterministicSourcePaths>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>


	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Options" Version="9.0.12" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />
	</ItemGroup>

	<!-- SourceLink for better debugging support -->
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>

</Project>
